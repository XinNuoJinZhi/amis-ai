# dcloudio 全家桶只在 npmmirror 发布，需要指定镜像源
@dcloudio:registry=https://registry.npmmirror.com

# @dcloudio/vite-plugin-uni 内部用相对路径 ../../../uni-cli-shared/dist 查找兄弟依赖，
# pnpm 默认严格模式只在 .pnpm/ 下建软链 → vite-plugin-uni 找不到 uni-cli-shared，
# 抛出 Error: Cannot find module '../../../uni-cli-shared/dist' 启动失败。
# 解决：把 dcloudio 全家桶 hoist 到顶层 node_modules，让相对路径能解析。
public-hoist-pattern[]=*@dcloudio/*
shamefully-hoist=true
