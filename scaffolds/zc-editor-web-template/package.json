{
  "name": "zc-editor-web-template",
  "version": "1.3.0",
  "private": true,
  "description": "ZC Amis Web 端底座（amis-ai 1.3.0 反向飞轮使用，基于 ZC fork amis 6.8.0-my324v2）",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "biome:lint": "npx @biomejs/biome lint",
    "build": "cross-env REACT_APP_ENV=production max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env PORT=5000 NODE_OPTIONS=--max-old-space-size=8192 MOCK=true REACT_APP_ENV=development UMI_ENV=dev max dev",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview --port 5000",
    "start:pro": "cross-env MOCK=none REACT_APP_ENV=production UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
