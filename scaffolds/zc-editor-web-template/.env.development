# 开发环境
REACT_APP_ENV=development

# 请求路径
REACT_APP_BASE_URL='http://192.168.50.218:38080'
# REACT_APP_BASE_URL='https://frp.xinnuojinzhi.com:8957'
# REACT_APP_BASE_URL='http://localhost:48080'

# 管理端地址
REACT_APP_ADMIN_URL='http://localhost'

# goview
REACT_APP_GOVIEW_URL='http://localhost:8080'

# 打包路径
REACT_APP_BASE_PATH=/

# 上传路径
REACT_APP_UPLOAD_URL='http://localhost:48080/admin-api/infra/file/upload'

# socket
REACT_APP_SOCKET_URL='http://localhost:9020'

# 输出路径
REACT_APP_OUT_DIR=dist-dev

# 是否删除debugger
REACT_APP_DROP_DEBUGGER=false

# 是否删除console.log
REACT_APP_DROP_CONSOLE=false

# 是否sourcemap
REACT_APP_SOURCEMAP=false

# 使用模拟数据
REACT_APP_APP_MOCK_DATA=false

# 高级功能开关
REACT_APP_APP_ADVANCE_FEATURE=true

# 验证码的开关
REACT_APP_APP_CAPTCHA_ENABLE=false

# sheet编辑器的路径
REACT_APP_SHEET_EDITOR_PATH='/app/design/sheetEditor'

# ai助手DEBUG开关
REACT_APP_AI_HELPER_DEBUG=true

# 测试模式
REACT_APP_TEST_MODE=true
